{
  "name": "medassist-hub",
  "version": "2.0.0",
  "description": "MedAssist Hub - personal health assistant: symptom triage, medication tracker, vitals, appointments, hospital locator",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check": "node scripts/check.js",
    "seed": "node scripts/seed-demo.js",
    "demo": "node scripts/seed-demo.js && node server/index.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/css/tailwind.css --minify"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
