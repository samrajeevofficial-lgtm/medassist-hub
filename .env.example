# Copy this file to .env and fill in the values (or run: node scripts/setup-env.js).

# Port the server listens on
PORT=3000

# Secret used to sign login tokens. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional: Google Gemini API key for AI symptom analysis (free tier, no card needed).
# Get one at https://aistudio.google.com/apikey  - leave blank to use only the built-in rule engine.
# In GitHub Codespaces you can add it as a Codespaces secret instead of writing it here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# How much the model "thinks" before answering: minimal, low, medium, high. Low keeps triage fast.
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_MS=40000

# Optional: openFDA key for higher rate limits (works fine without one).
OPENFDA_API_KEY=

# Emergency numbers shown in the app (India defaults)
EMERGENCY_NUMBER=112
AMBULANCE_NUMBER=108
# Tele-MANAS national mental health helpline (India)
MENTAL_HEALTH_HELPLINE=14416
# Country code added to 10-digit contact numbers for WhatsApp links
DEFAULT_COUNTRY_CODE=91

# Demo account (created by "npm run seed"; one-click "Explore the demo account" button)
DEMO_EMAIL=demo@medassist.app
DEMO_PASSWORD=Demo@1234
DEMO_TIMEZONE=Asia/Kolkata
# Set to false on a public server to hide the one-click demo login
ALLOW_DEMO_LOGIN=true
